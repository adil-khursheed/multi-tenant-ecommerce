{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate:types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate:types"]
    },
    "dev": {
      "dependsOn": ["generate:types"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "generate:types": {
      "cache": false
    }
  }
}
