{
  "expo": {
    "name": "DTlea",
    "slug": "dtlea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-icon-foreground.png",
    "scheme": "dtlea",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/fbd08d92-3868-4d39-a268-932ba0449c2d"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DTlea needs your location access.",
        "NSUserTrackingUsageDescription": "DTlea uses tracking data to improve your experience by personalizing content and advertisements.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["itms-apps"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faf8f6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["com.google.android.gms.permission.AD_ID"],
      "package": "com.dtlea.dtlea"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf8f6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DMSans-Light.ttf",
            "./assets/fonts/DMSans-Regular.ttf",
            "./assets/fonts/DMSans-Medium.ttf",
            "./assets/fonts/DMSans-SemiBold.ttf",
            "./assets/fonts/DMSans-Bold.ttf",
            "./assets/fonts/CormorantGaramond-Light.ttf",
            "./assets/fonts/CormorantGaramond-Regular.ttf",
            "./assets/fonts/CormorantGaramond-Medium.ttf",
            "./assets/fonts/CormorantGaramond-SemiBold.ttf",
            "./assets/fonts/CormorantGaramond-Bold.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DTlea to use your location to show you the product price in your local currency."
        }
      ],
      [
        "expo-updates",
        {
          "username": "dtlea"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "DTlea uses tracking data to improve your experience by personalizing content and advertisements."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fbd08d92-3868-4d39-a268-932ba0449c2d"
      }
    },
    "owner": "dtlea"
  }
}
